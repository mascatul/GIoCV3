<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package identity -->
    <PackageId>GIoC</PackageId>
    <Version>0.3.2</Version>
    <Title>GIoC — Godot 4 IoC, INPC &amp; Commands</Title>
    <Description>
      Lightweight IoC container, observable INPC properties ([Observable]),
      relay commands ([RelayCommand] / [AsyncRelayCommand]), typed static messaging
      (Messenger), and auto-injection via [Register] + [Inject] for Godot 4 C# projects.
      Bundles the GIoC.SourceGenerator Roslyn analyzer — no separate package needed.
    </Description>
    <Authors>GodotFlex</Authors>
    <PackageTags>Godot Godot4 IoC MVVM Observable RelayCommand Messenger DependencyInjection</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Emit generated files to disk during development so they're visible -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only — Godot.NET.Sdk provides GodotSharp at runtime in consuming projects -->
    <PackageReference Include="GodotSharp" Version="[4.0,5.0)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Exclude generator source, the Links addon and the test project from the main compilation.
       Links files are standalone - users copy them into their Godot project
       (which uses Godot.NET.Sdk so [Tool]/[GlobalClass] are processed correctly). -->
  <ItemGroup>
    <Compile Remove="source-generator\**\*.cs" />
    <Compile Remove="src\Links\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GIoC.Tests" />
  </ItemGroup>

  <!-- Source generator: built once as a project reference and used as an analyzer for this project's own build.
       (Replaces an Exec that re-ran "dotnet build" on the generator before every build, which raced with
       the project-graph build when several projects referenced it.) -->
  <ItemGroup>
    <ProjectReference Include="source-generator\GIoC.SourceGenerator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Bundle the source generator into the NuGet package's analyzers folder.
       NuGet automatically promotes DLLs from analyzers/dotnet/cs/ to <Analyzer> items
       in the consuming project - no manual csproj edits needed.
       Added from a target so the path is resolved after the generator has been built. -->
  <Target Name="IncludeSourceGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="source-generator\bin\$(Configuration)\netstandard2.0\GIoC.SourceGenerator.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>